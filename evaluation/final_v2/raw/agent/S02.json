            "code": "import csv\nimport json\nimport math\ncases = []\nfor i in range(5):\n    k = round(10.0 + i * 10.0, 12)\n    value = 2*k+5\n    if not math.isfinite(value):\n        raise ValueError('non-finite simulation value')\n    cases.append({'parameter': k, 'value': value})\nbest = max(cases, key=lambda row: row['value'])\nworst = min(cases, key=lambda row: row['value'])\nresult = {'cases': cases, 'best': best, 'worst': worst, 'mean': sum(row['value'] for row in cases) / len(cases), 'range': max(row['value'] for row in cases) - min(row['value'] for row in cases)}\nwith open('simulation.json', 'w', encoding='utf-8') as handle:\n    json.dump(result, handle, allow_nan=False)\nwith open('simulation.csv', 'w', newline='', encoding='utf-8') as handle:\n    writer = csv.DictWriter(handle, fieldnames=['parameter', 'value'])\n    writer.writeheader()\n    writer.writerows(cases)\n",
